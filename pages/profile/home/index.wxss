.page-detail {
  background: var(--tb);
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* ===== 顶部英雄区 ===== */
.hero-header {
  position: relative;
  padding: 60rpx 48rpx 48rpx;
  background: linear-gradient(160deg, var(--tp-d) 0%, var(--tp) 40%, var(--tp-l) 75%, var(--tp-ll) 100%);
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.hero-more {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 88rpx;
  min-width: 88rpx;
  padding: 0 20rpx;
}

.hero-more-icon {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.9);
}

.hero-more-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.hero-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.hero-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 20rpx;
}

.hero-nickname {
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.hero-role {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.18);
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 8rpx;
}

.hero-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 32rpx;
  position: relative;
}

.action-watch {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 48rpx;
  background: rgba(255, 255, 255, 0.28);
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.action-watch.watched {
  background: rgba(255, 255, 255, 0.18);
  border-color: rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.92);
}

.action-hello {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 48rpx;
  background: #fff;
  border-radius: 44rpx;
  color: var(--tp);
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* ===== 子女信息卡片 ===== */
.child-card {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(var(--ts), 0.10);
  position: relative;
}

.child-photo-hero {
  position: relative;
  width: 100%;
  height: 680rpx;
  background: #1a1a1a;
}

.child-swiper {
  width: 100%;
  height: 100%;
}

.child-photo {
  width: 100%;
  height: 100%;
}

.child-photo-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 160rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.35) 0%, transparent 100%);
  pointer-events: none;
}

.child-photo-tags {
  position: absolute;
  left: 32rpx;
  bottom: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.photo-tag-relation {
  display: inline-block;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  background: rgba(var(--ts), 0.85);
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}

.photo-tag-summary {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.child-detail {
  padding: 0 32rpx 32rpx;
}

.detail-highlight {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--tb-l);
}

.highlight-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.highlight-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tt);
}

.highlight-value.placeholder {
  color: #999;
  font-weight: 400;
}

.highlight-label {
  font-size: 26rpx;
  color: #555;
}

.highlight-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--tb-a2);
}

.detail-rows {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 28rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.detail-icon {
  font-size: 34rpx;
  width: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.detail-label {
  font-size: 26rpx;
  color: #555;
  width: 68rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.detail-value.placeholder {
  color: #999;
  font-weight: 400;
}

.detail-desc {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--tb-ll);
  border-radius: 16rpx;
}

.desc-text {
  font-size: 30rpx;
  color: #555;
  line-height: 1.8;
}

/* ===== 动态区域 ===== */
.moment-section {
  margin: 0 32rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 0 16rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-label {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tt);
}

.section-count {
  font-size: 26rpx;
  color: #666;
  margin-left: 4rpx;
}

.moment-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.moment-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(var(--ts), 0.05);
}

.moment-text {
  font-size: 34rpx;
  color: #1a1a1a;
  line-height: 1.8;
}

.moment-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.moment-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
}

.moment-img.single {
  width: 240rpx;
  height: auto;
}

.moment-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: 4rpx;
  border-top: 1rpx solid var(--tb);
}

.moment-actions {
  display: flex;
  gap: 48rpx;
}

.moment-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 4rpx 4rpx;
}

.action-icon {
  font-size: 44rpx;
  line-height: 1;
}

.action-icon.liked {
  transform: scale(1.2);
}

.action-count {
  font-size: 30rpx;
  color: #666;
}

.action-count.liked {
  color: var(--tp);
  font-weight: 600;
}

/* 评论：气泡图标（SVG 实心，红心红 #E53935，与点赞 ❤️ 同色；两主题同色）*/
.icon-comment {
  width: 42rpx;
  height: 42rpx;
  position: relative;
  top: 5rpx;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0iI0U1MzkzNSI+PHBhdGggZD0iTTMgMSBIMjEgYTIgMiAwIDAgMSAyIDIgVjE4IGEyIDIgMCAwIDEtMiAyIEg2IGwtNSAzIFYzIGEyIDIgMCAwIDEgMi0yIFoiLz48L3N2Zz4=");
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.theme-purple .icon-comment {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0iI0U1MzkzNSI+PHBhdGggZD0iTTMgMSBIMjEgYTIgMiAwIDAgMSAyIDIgVjE4IGEyIDIgMCAwIDEtMiAyIEg2IGwtNSAzIFYzIGEyIDIgMCAwIDEgMi0yIFoiLz48L3N2Zz4=");
}

.moment-meta {
  font-size: 28rpx;
  color: #666;
}

/* 评论区 */
.comment-section {
  background: var(--tb-ll);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.comment-more {
  padding-top: 8rpx;
}

.comment-more-text {
  font-size: 30rpx;
  color: var(--tp);
  font-weight: 600;
}

.comment-item {
  font-size: 32rpx;
  line-height: 1.75;
  color: #1a1a1a;
}

.comment-user {
  color: #070707;
  font-weight: 600;
}

.comment-reply {
  color: #777;
}

.comment-replier {
  color: #070707;
  font-weight: 600;
}

.comment-text {
  color: #1a1a1a;
}

/* 评论输入栏（主页为 navigateTo 页，无 tabbar，评论栏固定在底部，预留安全区）*/
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 10000;
}

.comment-input {
  flex: 1;
  height: 88rpx;
  background: var(--tb);
  border-radius: 44rpx;
  padding: 0 32rpx;
  font-size: 34rpx;
}

.comment-send-btn {
  padding: 20rpx 44rpx;
  background: linear-gradient(135deg, var(--tp), var(--tp-l));
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 44rpx;
  flex-shrink: 0;
}

.empty-moments {
  text-align: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 34rpx;
  color: #666;
}

.list-footer {
  text-align: center;
  padding: 32rpx 0;
}

.footer-text {
  font-size: 28rpx;
  color: #777;
}
