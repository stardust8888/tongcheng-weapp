<view class="page-settings {{themeClass}}">
  <view class="settings-section">
    <view class="settings-row" bindtap="goBlackList">
      <text class="settings-label">黑名单</text>
      <view class="settings-right">
        <text class="settings-arrow">›</text>
      </view>
    </view>
    <view class="settings-row">
      <text class="settings-label">页面风格</text>
      <view class="theme-options">
        <view class="theme-option {{currentTheme === 'coral' ? 'selected' : ''}}" bindtap="switchTheme" data-theme="coral">
          <view class="theme-dot coral-dot"></view>
          <text class="theme-name">珊瑚红</text>
        </view>
        <view class="theme-option {{currentTheme === 'purple' ? 'selected' : ''}}" bindtap="switchTheme" data-theme="purple">
          <view class="theme-dot purple-dot"></view>
          <text class="theme-name">优雅紫</text>
        </view>
      </view>
    </view>
    <view class="settings-row" bindtap="goFeedback">
      <text class="settings-label">反馈</text>
      <view class="settings-right">
        <text class="settings-arrow">›</text>
      </view>
    </view>
    <view class="settings-row" bindtap="clearCache">
      <text class="settings-label">清理缓存</text>
      <view class="settings-right">
        <text class="settings-value">{{cacheSize}}</text>
        <text class="settings-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="settings-section">
    <block wx:if="{{deleteApplied}}">
      <view class="settings-row delete-applied-row">
        <view class="delete-applied-info">
          <text class="settings-label">已申请注销</text>
          <text class="delete-applied-desc">将于 {{deleteExpectAt}} 正式删除账号及全部资料，冷静期内可随时取消</text>
        </view>
      </view>
      <view class="settings-row" bindtap="cancelDelete">
        <text class="settings-label cancel-text">取消注销</text>
        <view class="settings-right">
          <text class="settings-arrow">›</text>
        </view>
      </view>
    </block>
    <view class="settings-row" wx:else bindtap="applyDelete">
      <text class="settings-label">注销账号</text>
      <view class="settings-right">
        <text class="settings-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="logout-wrap">
    <view class="logout-btn" bindtap="logout">
      <text class="logout-text">退出登录</text>
    </view>
  </view>
</view>
