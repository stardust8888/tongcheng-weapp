.page-watch {
  background: var(--tb);
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.watch-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.watch-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(var(--ts), 0.06);
}

/* 已关注按钮 */
.watch-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  background: var(--tt);
  border-radius: 44rpx;
  margin-left: auto;
}

.watch-toggle-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

/* 子女卡片 - 与推荐页一致 */
.card-body {
  display: flex;
  gap: 32rpx;
}

.card-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.card-avatar {
  width: 240rpx;
  height: 300rpx;
  border-radius: 20rpx;
  object-fit: cover;
}

.card-match-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 8rpx 20rpx;
  background: rgba(var(--ts), 0.9);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 20rpx;
}

.card-summary {
  font-size: 42rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.card-detail-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card-detail-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-label {
  font-size: 36rpx;
  color: #555;
  width: 72rpx;
}

.detail-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.card-desc {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--tb-ll);
  border-radius: 12rpx;
}

.desc-text {
  font-size: 32rpx;
  color: #555;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 家长行 */
.card-parent {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F5F2FA;
}

.parent-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 2rpx solid var(--tb-l);
}

.parent-name {
  flex: 1;
  font-size: 30rpx;
  color: #666;
}

.btn-hello {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 40rpx;
  background: linear-gradient(135deg, var(--tp), var(--tp-l));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

/* 空状态 */
.empty-wrap {
  background: #fff;
  border-radius: 24rpx;
  padding: 160rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-top: 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 34rpx;
  color: #555;
  font-weight: 500;
}

.empty-hint {
  font-size: 28rpx;
  color: #777;
}
