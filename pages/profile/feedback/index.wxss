.page-feedback {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

.feedback-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.feedback-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 卡片内分区 */
.card-section {
  position: relative;
}
.card-section + .card-section {
  margin-top: 24rpx;
}

/* 标签行：左侧图标+文字，右侧状态标记 */
.section-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.label-left {
  display: flex;
  align-items: center;
}
.label-icon {
  font-size: 34rpx;
  margin-right: 12rpx;
  line-height: 1;
}
.label-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* 状态标记（已回复/处理中），一眼可辨 */
.card-status {
  padding: 6rpx 20rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.card-status.status-replied {
  background: #E7F5EA;
  color: #2E7D32;
}
.card-status.status-pending {
  background: #FFF1E0;
  color: #E65100;
}

/* 正文：大字号、高对比、宽松行距，适合老年人阅读 */
.section-body {
  font-size: 34rpx;
  color: #1a1a1a;
  line-height: 1.75;
  word-break: break-word;
}

/* 时间行 */
.section-meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.meta-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
  line-height: 1;
}
.meta-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 6rpx;
}
.meta-value {
  font-size: 28rpx;
  color: #555;
}

/* 官方回复区：浅底色 + 左侧色条，与“我的问题”明显区分 */
.section-reply {
  background: #FFF7F4;
  border-left: 8rpx solid #F06B6B;
  border-radius: 12rpx;
  padding: 24rpx 24rpx 24rpx 28rpx;
}
.theme-purple .section-reply {
  background: #F7F2FF;
  border-left-color: #8841F3;
}

/* 暂未回复 */
.section-pending .pending-text {
  font-size: 30rpx;
  color: #555;
  line-height: 1.7;
}

.list-footer {
  text-align: center;
  padding: 32rpx 0;
}

.footer-text {
  font-size: 26rpx;
  color: #666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 32rpx;
  color: #666;
}

.empty-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #777;
}

.fab-feedback {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f06b6b;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(240, 107, 107, 0.4);
}

.fab-text {
  font-size: 30rpx;
  color: #fff;
}

.feedback-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10;
}

/* 底部弹出的输入面板（老年友好：标题 + 大输入框 + 整宽按钮）*/
.feedback-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 11;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.sheet-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 40rpx;
  color: #666;
  background: #f2f2f2;
  border-radius: 50%;
}

.feedback-textarea {
  width: 100%;
  min-height: 240rpx;
  max-height: 480rpx;
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: #1a1a1a;
  line-height: 1.6;
  box-sizing: border-box;
}
.textarea-ph {
  color: #aaa;
  font-size: 32rpx;
}

.feedback-send-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #f06b6b;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}
.feedback-send-btn.disabled {
  opacity: 0.6;
}
