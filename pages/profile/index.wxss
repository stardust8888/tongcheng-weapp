.page-profile {
  background: var(--tb);
  padding-bottom: 180rpx;
}

/* 顶部用户栏 */
.user-header {
  padding: 48rpx 48rpx 32rpx;
  background: linear-gradient(135deg, var(--tp) 0%, var(--tp-l) 60%, var(--tp-ll) 100%);
}

.user-greeting {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
  margin-right: 8rpx;
}

.greeting-text {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  max-width: 220rpx;
}

.greeting-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 数据统计栏 */
.user-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 36rpx;
  padding: 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.25);
  flex-shrink: 0;
}

/* 子女信息主卡片 */
.child-hero {
  position: relative;
  margin: -20rpx 32rpx 32rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(var(--ts), 0.12);
}

.child-hero-bg {
  position: absolute;
  top: 0;
  right: 0;
  width: 240rpx;
  height: 240rpx;
  background: linear-gradient(135deg, rgba(var(--ts), 0.06), rgba(var(--ts), 0.03));
  border-radius: 0 0 0 240rpx;
}

.child-edit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 12rpx;
  padding: 0;
  background: var(--tb-l);
  border-radius: 16rpx;
}

.child-edit-btn text {
  font-size: 34rpx;
  color: var(--tp);
  font-weight: 600;
}

.child-hero-content {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 32rpx;
  position: relative;
}

.child-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  flex: 1;
}

.child-avatar {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  object-fit: cover;
}

.child-relation-tag {
  position: absolute;
  top: 0;
  left: 0;
  padding: 8rpx 20rpx;
  background: rgba(var(--ts), 0.9);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 20rpx 0 12rpx 0;
}

.child-status {
  position: absolute;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 10rpx 28rpx;
  background: rgba(var(--ts), 0.9);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  white-space: nowrap;
}

.child-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}

.child-summary {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.child-detail-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.child-detail-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-label {
  font-size: 30rpx;
  color: #555;
  width: 72rpx;
}

.detail-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.detail-value.placeholder {
  color: #999;
  font-weight: 400;
}

.child-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 48rpx 56rpx;
  position: relative;
}

.empty-icon-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--tb-a) 0%, var(--tb-l) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-icon-plus {
  font-size: 56rpx;
  color: var(--tp);
  font-weight: 300;
  line-height: 1;
}

.child-empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.child-empty-desc {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 40rpx;
}

.child-add-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0;
  background: linear-gradient(135deg, var(--tp) 0%, var(--tp-l) 100%);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(var(--ts), 0.3);
}

.child-add-btn text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 功能入口 */
.menu-section {
  margin: 0 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 32rpx 36rpx;
  gap: 24rpx;
}

.menu-row+.menu-row {
  border-top: 1rpx solid var(--tb-ll);
}

.menu-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon {
  font-size: 38rpx;
}

.menu-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.menu-desc {
  font-size: 26rpx;
  color: #555;
}

.menu-arrow {
  font-size: 40rpx;
  color: #999;
  font-weight: 300;
}