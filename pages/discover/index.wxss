.page-discover {
  background: var(--tb);
  padding: 24rpx;
  padding-bottom: 180rpx;
}

/* 推荐列表 */
.discover-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.discover-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(var(--ts), 0.06);
}

.card-body {
  display: flex;
  gap: 32rpx;
}

/* 头像区域 */
.card-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.card-avatar {
  width: 240rpx;
  height: 350rpx;
  border-radius: 20rpx;
  object-fit: cover;
}

.card-match-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 8rpx 20rpx;
  background: rgba(var(--ts), 0.9);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

/* 信息区域 */
.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 20rpx;
}

.card-summary {
  font-size: 42rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.card-detail-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card-detail-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-label {
  font-size: 36rpx;
  color: #555;
  width: 72rpx;
}

.detail-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.detail-value.placeholder {
  color: #999;
  font-weight: 400;
}

.card-desc {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--tb-ll);
  border-radius: 12rpx;
}

.desc-text {
  font-size: 32rpx;
  color: #555;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  /* Standard property for compatibility */
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 操作按钮 */
.card-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 28rpx;
}

.btn-detail {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0;
  border: 2rpx solid var(--tp);
  color: var(--tp);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.btn-hello {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0;
  background: linear-gradient(135deg, var(--tp), var(--tp-l));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.list-footer {
  text-align: center;
  padding: 32rpx 0 16rpx;
}

.footer-text {
  font-size: 28rpx;
  color: #777;
}

.empty-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 34rpx;
  color: #555;
  font-weight: 500;
}

.empty-hint {
  font-size: 28rpx;
  color: #777;
}
