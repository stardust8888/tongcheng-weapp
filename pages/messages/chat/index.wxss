.page-chat {
  background: linear-gradient(180deg, var(--tb) 0%, var(--tb-lll) 100%);
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.msg-scroll {
  flex: 1;
  min-height: 0;
  padding: 20rpx 28rpx 0;
  box-sizing: border-box;
}

.msg-loading {
  text-align: center;
  padding: 20rpx 0;
}

.msg-loading-text {
  font-size: 28rpx;
  color: #777;
}

/* ---- 时间分隔线 ---- */
.time-divider {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 16rpx;
}

.time-divider-text {
  font-size: 26rpx;
  color: #777;
  background: rgba(255, 255, 255, 0.6);
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
}

/* ---- 系统消息 ---- */
.msg-system {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.msg-system-text {
  font-size: 26rpx;
  color: #777;
  background: rgba(var(--ts), 0.06);
  padding: 8rpx 28rpx;
  border-radius: 20rpx;
}

/* ---- 消息列表 ---- */
.msg-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-bottom: 24rpx;
}

/* ---- 消息行 ---- */
.msg-item {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 12rpx 0;
}

.msg-self {
  flex-direction: row-reverse;
}

/* ---- 头像 ---- */
.msg-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid rgba(var(--ts), 0.12);
  box-shadow: 0 4rpx 12rpx rgba(var(--ts), 0.1);
}

/* ---- 消息内容区 ---- */
.msg-body {
  max-width: 65%;
  display: flex;
  flex-direction: column;
}

.msg-self .msg-body {
  align-items: flex-end;
}

.msg-other .msg-body {
  align-items: flex-start;
}

/* ---- 气泡基础 ---- */
.msg-bubble {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 28rpx 34rpx;
  border-radius: 32rpx;
  word-break: break-all;
}

/* ---- 自己的气泡：渐变紫 ---- */
.bubble-self {
  background: linear-gradient(135deg, var(--tp-m) 0%, var(--tp-dd) 100%);
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(123, 47, 242, 0.25);
}

.bubble-self .msg-text {
  color: #fff;
  font-size: 36rpx;
  line-height: 1.7;
  letter-spacing: 0.5rpx;
}

/* ---- 对方的气泡：白色卡片 ---- */
.bubble-other {
  background: #fff;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(var(--ts), 0.08);
}

.bubble-other .msg-text {
  color: var(--tt);
  font-size: 36rpx;
  line-height: 1.7;
  letter-spacing: 0.5rpx;
}

/* ---- 图片气泡 ---- */
.bubble-image {
  padding: 6rpx;
  background: transparent;
  box-shadow: none;
  border-radius: 20rpx;
  overflow: hidden;
}

.msg-img {
  max-width: 400rpx;
  min-width: 200rpx;
  border-radius: 16rpx;
}

/* ---- 消息状态（气泡内右下） ---- */
.msg-status {
  flex-shrink: 0;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1;
}

.msg-status-read {
  color: rgba(255, 255, 255, 0.9);
}

/* ---- 未读分界线 ---- */
.unread-divider {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  gap: 16rpx;
}

.unread-divider-line {
  flex: 1;
  height: 1rpx;
  background: rgba(var(--ts), 0.3);
}

.unread-divider-text {
  font-size: 26rpx;
  color: var(--tp);
  white-space: nowrap;
}

/* ---- 未读消息提示 ---- */
.new-msg-tip {
  position: absolute;
  right: 32rpx;
  bottom: 140rpx;
  display: flex;
  align-items: center;
  min-height: 80rpx;
  padding: 0 28rpx;
  background: linear-gradient(135deg, var(--tp) 0%, var(--tp-l) 100%);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(var(--ts), 0.4);
  z-index: 10;
}

.new-msg-tip-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

/* ---- 底部输入栏 ---- */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(var(--ts), 0.06);
  box-sizing: border-box;
}

.msg-input {
  flex: 1;
  height: 88rpx;
  padding: 0 32rpx;
  background: #F5F2FA;
  border-radius: 44rpx;
  font-size: 32rpx;
  color: var(--tt);
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.send-btn {
  width: 130rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #B89FD0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}

.send-btn-active {
  background: linear-gradient(135deg, var(--tp-m) 0%, var(--tp-dd) 100%);
  box-shadow: 0 4rpx 16rpx rgba(123, 47, 242, 0.3);
}

.send-btn-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
}
