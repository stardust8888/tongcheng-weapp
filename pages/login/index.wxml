<view class="page-login {{themeClass}}">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="bg-circle circle-1"></view>
    <view class="bg-circle circle-2"></view>
    <view class="bg-circle circle-3"></view>
  </view>

  <!-- 验证成功过渡 -->
  <block wx:if="{{step === 'verified'}}">
    <view class="verified-area">
      <view class="verified-icon-wrap">
        <view class="verified-icon-circle">
          <text class="verified-check">✓</text>
        </view>
      </view>
      <text class="verified-title">验证成功</text>
      <view class="verified-phone-card">
        <text class="verified-phone-label">手机号</text>
        <text class="verified-phone-num">{{phone}}</text>
      </view>
      <view class="verified-loading">
        <view class="btn-loader"></view>
        <text class="verified-loading-text">正在登录...</text>
      </view>
    </view>
  </block>

  <!-- 登录主页面（login 和 phone 共用） -->
  <block wx:if="{{step !== 'verified'}}">
    <!-- 品牌区域 -->
    <view class="brand-area">
      <view class="logo-wrap">
        <view class="logo-icon">
          <text class="logo-text">缘</text>
        </view>
      </view>
      <text class="app-name">爸妈来牵线</text>
      <text class="app-slogan">为孩子的幸福，用心牵线</text>
    </view>

    <!-- 信任指标 -->
    <view class="trust-area">
      <view class="trust-item">
        <view class="trust-dot"></view>
        <text class="trust-text">微信认证</text>
      </view>
      <view class="trust-item">
        <view class="trust-dot"></view>
        <text class="trust-text">信息保密</text>
      </view>
      <view class="trust-item">
        <view class="trust-dot"></view>
        <text class="trust-text">真实可靠</text>
      </view>
    </view>

    <!-- 操作区 -->
    <view class="action-area">
      <!-- 微信一键登录 -->
      <button
        wx:if="{{step === 'login'}}"
        class="login-btn {{loading ? 'loading' : ''}}"
        bindtap="onFastLogin"
        disabled="{{loading}}"
      >
        <view class="btn-content">
          <view class="btn-loader" wx:if="{{loading}}"></view>
          <text class="btn-text">{{loading ? '登录中...' : '微信一键登录'}}</text>
        </view>
      </button>

      <!-- 协议 -->
      <view class="agreement-area">
        <view class="agreement-row" bindtap="toggleUserAgreement">
          <view class="agreement-check {{agreedUser ? 'checked' : ''}}">
            <text class="check-icon" wx:if="{{agreedUser}}">✓</text>
          </view>
          <text class="agreement-row-text">我已阅读并同意</text>
          <text class="agreement-link" catchtap="showUserAgreement">《用户协议》</text>
        </view>
        <view class="agreement-row" bindtap="togglePrivacy">
          <view class="agreement-check {{agreedPrivacy ? 'checked' : ''}}">
            <text class="check-icon" wx:if="{{agreedPrivacy}}">✓</text>
          </view>
          <text class="agreement-row-text">我已阅读并同意</text>
          <text class="agreement-link" catchtap="showPrivacy">《隐私政策》</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 注册底部弹框 -->
  <view class="register-overlay {{showRegister ? 'show' : ''}}" bindtap="closeRegisterSheet">
    <view class="register-sheet" catchtap="">
      <view class="register-sheet-bar"></view>
      <text class="register-sheet-title">欢迎加入爸妈来牵线</text>
      <text class="register-sheet-desc">授权手机号完成注册，开启寻缘之旅</text>
      <button
        class="register-btn {{loading ? 'loading' : ''}}"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        disabled="{{loading}}"
      >
        <view class="btn-content">
          <view class="btn-loader" wx:if="{{loading}}"></view>
          <text class="btn-text">{{loading ? '注册中...' : '微信一键注册'}}</text>
        </view>
      </button>
      <view class="register-sheet-skip" bindtap="closeRegisterSheet">
        <text>暂不注册</text>
      </view>
    </view>
  </view>
</view>
