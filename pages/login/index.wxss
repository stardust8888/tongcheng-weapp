.page-login {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  overflow: hidden;
  background: linear-gradient(180deg, var(--tb) 0%, #FFFFFF 50%, var(--tb) 100%);
}

/* 背景装饰 */
.bg-decoration {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.08;
}

.circle-1 {
  width: 480rpx;
  height: 480rpx;
  background: var(--tp);
  top: -120rpx;
  right: -100rpx;
}

.circle-2 {
  width: 320rpx;
  height: 320rpx;
  background: var(--tp-l);
  top: 400rpx;
  left: -160rpx;
}

.circle-3 {
  width: 240rpx;
  height: 240rpx;
  background: var(--tp-dd);
  bottom: 300rpx;
  right: -80rpx;
}

/* 品牌区域 */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.logo-wrap {
  margin-bottom: 32rpx;
}

.logo-icon {
  width: 144rpx;
  height: 144rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--tp) 0%, var(--tp-l) 50%, var(--tp-ll) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(var(--ts), 0.3);
}

.logo-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
}

.app-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #555;
  letter-spacing: 2rpx;
}

/* 信任指标 */
.trust-area {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  padding: 64rpx 0;
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.trust-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--tp), var(--tp-l));
}

.trust-text {
  font-size: 28rpx;
  color: #555;
  font-weight: 500;
}

/* 操作区域 */
.action-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin-top: 200rpx;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 52rpx;
  background: linear-gradient(135deg, var(--tp) 0%, var(--tp-l) 100%);
  border: none;
  padding: 0;
  margin-top: 0;
  box-shadow: 0 12rpx 40rpx rgba(var(--ts), 0.35);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn::after {
  border: none;
}

.login-btn.loading {
  opacity: 0.85;
  box-shadow: 0 8rpx 24rpx rgba(var(--ts), 0.2);
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  gap: 16rpx;
}

.btn-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.btn-loader {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 协议区域 */
.agreement-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
  gap: 20rpx;
  width: 100%;
}

.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.agreement-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.agreement-check.checked {
  background: var(--tp);
  border-color: var(--tp);
}

.check-icon {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
}

.agreement-row-text {
  font-size: 28rpx;
  color: #555;
}

.agreement-link {
  font-size: 28rpx;
  color: var(--tp);
  font-weight: 600;
}

/* 手机号授权提示 */
.phone-hint {
  margin-bottom: 24rpx;
}

.phone-hint-text {
  font-size: 28rpx;
  color: #555;
}

.skip-link {
  margin-top: 24rpx;
  padding: 16rpx 32rpx;
}

.skip-link text {
  font-size: 28rpx;
  color: #666;
}

/* ===== 验证成功过渡页 ===== */
.verified-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.verified-icon-wrap {
  margin-bottom: 40rpx;
}

.verified-icon-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--tp) 0%, var(--tp-l) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(var(--ts), 0.3);
}

.verified-check {
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
}

.verified-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 48rpx;
  letter-spacing: 2rpx;
}

.verified-phone-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 48rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 64rpx;
}

.verified-phone-label {
  font-size: 30rpx;
  color: #555;
}

.verified-phone-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 4rpx;
}

.verified-loading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.verified-loading .btn-loader {
  border-color: rgba(var(--ts), 0.2);
  border-top-color: var(--tp);
}

.verified-loading-text {
  font-size: 28rpx;
  color: #555;
}

/* ===== 注册底部弹框 ===== */
.register-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  pointer-events: none;
  transition: background 0.3s ease;
}

.register-overlay.show {
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}

.register-sheet {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 64rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.register-overlay.show .register-sheet {
  transform: translateY(0);
}

.register-sheet-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #ddd;
  margin-bottom: 48rpx;
}

.register-sheet-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.register-sheet-desc {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 56rpx;
}

.register-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 52rpx;
  background: linear-gradient(135deg, var(--tp) 0%, var(--tp-l) 100%);
  border: none;
  padding: 0;
  box-shadow: 0 12rpx 40rpx rgba(var(--ts), 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.register-btn::after {
  border: none;
}

.register-btn.loading {
  opacity: 0.85;
}

.register-sheet-skip {
  margin-top: 32rpx;
  padding: 16rpx 32rpx;
}

.register-sheet-skip text {
  font-size: 28rpx;
  color: #666;
}
