.page-agreement {
  padding: 40rpx 48rpx;
  padding-bottom: 80rpx;
  background: #fff;
  min-height: 100vh;
}

.agreement-content {
  display: flex;
  flex-direction: column;
}

.agreement-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 16rpx;
}

.agreement-date {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-top: 40rpx;
  margin-bottom: 16rpx;
}

.section-body {
  font-size: 32rpx;
  color: #555;
  line-height: 1.8;
}
