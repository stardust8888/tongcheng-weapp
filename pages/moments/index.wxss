.page-moments {
  background: var(--tb);
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.moment-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.moment-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(var(--ts), 0.05);
}

.moment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.moment-user {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.moment-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid var(--tb-l);
  flex-shrink: 0;
}

.moment-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--tp-ll), var(--tp));
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.moment-user-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.moment-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.moment-nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--tt);
}

.tag-verified {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: var(--tb-l);
  color: var(--tp);
}

.moment-meta {
  font-size: 28rpx;
  color: #666;
}

.follow-btn {
  padding: 16rpx 40rpx;
  border: 2rpx solid var(--tp);
  color: var(--tp);
  border-radius: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.follow-btn.followed {
  background: var(--tt);
  border-color: var(--tt);
  color: #fff;
}

.moment-text {
  font-size: 34rpx;
  color: #1a1a1a;
  line-height: 1.8;
}

.moment-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.moment-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
}

.moment-img.single {
  width: 240rpx;
  height: auto;
}

.moment-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: 4rpx;
  border-top: 1rpx solid var(--tb);
}

.moment-actions {
  display: flex;
  gap: 48rpx;
}

.moment-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 4rpx 4rpx;
}

.action-icon {
  font-size: 44rpx;
  line-height: 1;
}

.action-icon.liked {
  transform: scale(1.2);
}

.action-count {
  font-size: 30rpx;
  color: #666;
}

.action-count.liked {
  color: var(--tp);
  font-weight: 600;
}

