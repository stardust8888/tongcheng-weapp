/* 评论区 */
.comment-section {
  background: var(--tb-ll);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.comment-more {
  padding-top: 8rpx;
}

.comment-more-text {
  font-size: 30rpx;
  color: var(--tp);
  font-weight: 600;
}

.comment-item {
  font-size: 32rpx;
  line-height: 1.75;
  color: #1a1a1a;
}

.comment-user {
  color: #070707;
  font-weight: 600;
}

.comment-reply {
  color: #777;
}

.comment-replier {
  color: #070707;
  font-weight: 600;
}

.comment-text {
  color: #1a1a1a;
}

/* 悬浮发布按钮 */
.fab-post {
  position: fixed;
  right: 80rpx;
  bottom: 260rpx;
  padding: 28rpx 48rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--tp), var(--tp-l));
  box-shadow: 0 8rpx 32rpx rgba(var(--ts), 0.4);
  z-index: 99;
  transition: opacity .25s ease, transform .25s ease;
}

.fab-post.fab-hidden {
  opacity: 0;
  transform: scale(.6);
  pointer-events: none;
}

.fab-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

/* 评论输入栏
   动态页是 tabbar 页：自定义 tabbar 固定在 bottom:0、z-index:9999、高约 124rpx+安全区。
   评论栏原先 bottom:0/z-index:100 会被 tabbar 整个盖住，导致点评论“没反应”。
   这里把评论栏上移到 tabbar 正上方，并提高 z-index 到 tabbar 之上。 */
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(124rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 10000;
}

.comment-input {
  flex: 1;
  height: 88rpx;
  background: var(--tb);
  border-radius: 44rpx;
  padding: 0 32rpx;
  font-size: 34rpx;
}

.comment-send-btn {
  padding: 20rpx 44rpx;
  background: linear-gradient(135deg, var(--tp), var(--tp-l));
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 44rpx;
  flex-shrink: 0;
}

/* 加载状态 */
.list-footer {
  text-align: center;
  padding: 32rpx 0 16rpx;
}

.footer-text {
  font-size: 28rpx;
  color: #555;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: 16rpx;
}

.empty-icon {
  font-size: 88rpx;
}

.empty-text {
  font-size: 34rpx;
  color: #666;
}

.empty-hint {
  font-size: 30rpx;
  color: #555;
}