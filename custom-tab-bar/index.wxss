.tab-bar {
  display: flex;
  align-items: flex-end;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 9999;
  box-shadow: 0 -4px 16px 0 rgba(0, 0, 0, 0.12);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 114rpx;
  background: #fff;
}

.tab-bar-item.active {
  height: 124rpx;
  background: linear-gradient(0deg, var(--tp) 0%, var(--tp-l) 93%);
  border-radius: 16rpx 16rpx 0 0;
}

.tab-text {
  font-size: 40rpx;
  color: #808080;
  font-weight: 600;
}

.tab-bar-item.active .tab-text {
  color: #fff;
}

.tab-text-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
}

.badge {
  position: absolute;
  top: -16rpx;
  right: -40rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 12rpx;
  border-radius: 20rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}
