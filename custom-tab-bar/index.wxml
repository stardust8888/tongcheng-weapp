<view class="tab-bar">
  <view
    class="tab-bar-item {{selected === index ? 'active' : ''}}"
    style="{{selected === index ? 'background:' + activeGradient : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-text-wrap">
      <text class="tab-text">{{item.text}}</text>
      <view class="badge" wx:if="{{index === 2 && totalUnread > 0}}">{{totalUnread > 99 ? '99+' : totalUnread}}</view>
    </view>
  </view>
</view>
